#!/usr/bin/env bash
# Blocks commits that add secrets or private identifiers.
# Enable once per clone: git config core.hooksPath .githooks
#
# Denylist: one fixed string per line (case-insensitive; # comments allowed),
# from $ORACLE_DENYLIST or the-oracle-ops/denylist.txt next to the main checkout
# (also from a git worktree). Keep it out of this repo.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
status=0

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --pre-commit --staged --no-banner --redact "$root" || status=1
else
    echo "pre-commit: gitleaks not installed; secret scan skipped" >&2
fi

main_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
denylist="${ORACLE_DENYLIST:-$main_root/../the-oracle-ops/denylist.txt}"
if [[ -f "$denylist" ]]; then
    patterns=$(grep -v -e '^\s*#' -e '^\s*$' "$denylist" || true)
    if [[ -n "$patterns" ]]; then
        hits=$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' \
            | grep -i -F -f <(printf '%s\n' "$patterns") || true)
        if [[ -n "$hits" ]]; then
            echo "pre-commit: staged changes contain denylisted text:" >&2
            printf '%s\n' "$hits" | cut -c1-200 >&2
            status=1
        fi
    fi
fi

exit $status
