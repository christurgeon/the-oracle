# =============================================================================
# The Oracle — Environment Variables
#
# All variables use the ORACLE_ prefix (mapped to Settings fields in settings.py).
# Copy this file to .env and fill in your values.
# Nested config (strategies, risk, etc.) lives in config.yaml, not here.
# =============================================================================

# -- Kalshi credentials --
ORACLE_KALSHI_API_KEY=
ORACLE_KALSHI_PRIVATE_KEY_PATH=

# -- Telegram bot (optional) --
ORACLE_TELEGRAM_BOT_TOKEN=
ORACLE_TELEGRAM_OWNER_CHAT_ID=

# -- Claude Code CLI (for the Telegram /agent command, optional) --
ORACLE_CLAUDE_CODE_BIN=

# -- Healthchecks.io dead-man's switch (optional) --
ORACLE_HEALTHCHECK_PING_URL=

# -- Bankroll (dollars) --
ORACLE_BANKROLL=10000.0

# -- Execution mode: shadow | paper | live --
# shadow logs signals only. live places REAL orders with real capital.
# Overrides execution.mode in python/config.yaml.
ORACLE_EXECUTION_MODE=shadow

# -- Private deployment overlay (optional) --
# YAML merged over python/config.yaml for the live-ops sections; see python/settings.py.
ORACLE_CONFIG_OVERLAY=

# -- VPS access for --pull-vps report scripts (optional) --
ORACLE_VPS_HOST=            # user@host
ORACLE_VPS_STATE_DIR=/opt/oracle/state
